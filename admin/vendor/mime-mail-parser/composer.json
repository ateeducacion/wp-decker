{
    "name": "erseco/mime-mail-parser",
    "description": "Parse emails without the mailparse extension",
    "keywords": [
        "erseco",
        "php",
        "mime",
        "mail",
        "email",
        "email parser"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Ernesto Serrano",
            "email": "info@ernesto.es",
            "role": "Developer"
        }
    ],
    "scripts": {
        "test": "vendor/bin/pest",
        "test-with-warnings": "vendor/bin/pest --display-warnings",
        "test-coverage": "mkdir -p coverage && vendor/bin/pest --coverage --min=75 --coverage-clover=coverage/clover.xml",
        "lint": "phpcs --standard=phpcs.xml.dist --warning-severity=0",
        "fix": "phpcbf --standard=phpcs.xml.dist --warning-severity=0",
        "analyse": "phpstan analyse --memory-limit=512M"
    },
    "autoload": {
        "psr-4": {
            "Erseco\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Erseco\\MimeMailParser\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "require-dev": {
        "pestphp/pest": "^1.23.1 || 2.35.1 || ^3.0 || ^4.0",
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^3.13 || ^4.0"
    }
}
