# Exclude common development files and folders
/node_modules/
/vendor/
/composer.lock
/package-lock.json
*.log
*.sql
*.sql.gz
*.tar.gz
*.zip
wp-decker*/
decker*/
*.swp
*.swo
*.bak
*.bkp
*.back
*.tmp
*~
.DS_Store
Thumbs.db
sftp-config.json

# Exclude specific editor/IDE files
/.idea/
.vscode/
.project
.settings/
*.sublime-workspace
*.sublime-project

# Exclude test-related files and directories
# /tests/
# /phpunit.xml
# /phpunit.xml.dist
.phpunit.result.cache
/behat.yml
.php-cs-fixer.cache
tests/junit.xml

decker/
.aider*
.env

wp/
wp-content/
wordpress-develop/
artifacts/

# Generated runtime translation files. Built from the committed .po sources
# by `make package` and shipped in the release ZIP; never committed.
languages/*.mo
languages/*.l10n.php
